{% for item in collections.sections %}
  {% if item.data.type === 'about' %}
    <div id="about" class="w-full flex flex-col justify-center items-center bg-black py-20 md:py-24">
      <div class="flex flex-col md:flex-row text-left w-full max-w-screen-xl">
        <div class="md:w-1/2 self-center p-4 md:pl-24 lg:pl-36">
          <h2 class="text-white text-4xl md:text-6xl lg:text-8xl font-medium mb-6">{{ item.data.title }}</h2>
          <div class="text-white text-xl">
            {{ item.templateContent | safe }}
          </div>
        </div>
        <div class="mx-auto p-0 sm:pd-2 md:p-4 md:w-1/2">
          {% image "./src/static/img/features/bike-ride-hints.png", "Planning a bike ride using ScreenHint, with windows showing the bike route, a message from a friend, and a bike shop's open hours.", "mt-12 md:my-12 max-w-full" %}
        </div>
      </div>
    </div>
  {% endif %}
{% endfor %}