{% for item in collections.sections %}
  {% if item.data.type === 'features' %}
    <section id="features" class="features">
      <div class="section-wrap features__grid">
        <div class="features__intro">
          <h2>{{ item.data.title }}</h2>
          <div class="features__text">
            {{ item.templateContent | safe }}
          </div>
        </div>

        <div class="features__cards">
          {% for item in features %}
            <article class="hint-card feature-card">
              <span class="feature-card__icon"><svg viewBox="0 0 24 24" aria-hidden="true">{{ item.icon | safe }}</svg></span>
              <h3>{{ item.title }}</h3>
              <p>{{ item.content | safe }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}
{% endfor %}
