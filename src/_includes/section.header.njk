</div>
<script>
	(function () {
		var scene = document.getElementById('heroScene');
		var state; // still → playing → resting → resetting → playing → …

		function enter(next) {
			state = next;
			scene.classList.toggle('is-still', next === 'still');
			scene.classList.toggle('is-resting', next === 'resting');
		}

		function play(continuing) {
			scene.classList.remove('is-resetting', 'is-playing', 'is-continuing');
			void scene.offsetWidth; // restart the animations
			scene.classList.add('is-playing');
			scene.classList.toggle('is-continuing', continuing);
			enter('playing');
		}

		function replay() {
			if (state === 'still') return play(false);
			if (state !== 'resting') return;
			scene.classList.remove('is-playing', 'is-continuing');
			scene.classList.add('is-resetting');
			enter('resetting');
		}

		// The pointer's animation runs for the whole of each sequence, so its end marks the sequence's end.
		scene.addEventListener('animationend', function (event) {
			if (event.animationName === 'scene-cursor') enter('resting');
			if (event.animationName === 'scene-cursor-reset') play(true);
		});

		scene.addEventListener('click', replay);
		scene.addEventListener('keydown', function (event) {
			if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				replay();
			}
		});

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) enter('still');
		else play(false);
	})();
</script>
