<div class="lg:mt-8 mt-10 flex-0 justify-center w-full text-center">
	<h1 class="text-black py-3 font-medium text-4xl md:text-5xl lg:text-6xl mb-0 leading-snug">Photographic memory<br/>at your fingertips.</h1>
</div>
<div class="hero-video">
	{# Plays once on load (unless Reduce Motion is on), then click, Enter, or Space plays it again.
	   The poster covers loading and no-JS. Sizing and framing live in custom.css (.hero-video). #}
	<div class="hero-video__frame">
		<video id="heroVideo" muted playsinline preload="auto" tabindex="0" title="Play again"
			poster="/video/screenhint-demo-poster.jpg" width="1920" height="1114"
			aria-label="ScreenHint in action: a keyboard shortcut dims the screen, the wind map in the Weather app is selected and becomes a floating hint, the hint is dragged beside the window, and a double-click closes it. Press to play.">
			<source src="/video/screenhint-demo.webm" type="video/webm">
			<source src="/video/screenhint-demo.mp4" type="video/mp4">
		</video>
	</div>
</div>
<script>
	(function () {
		var video = document.getElementById('heroVideo');
		var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		function toggle() {
			if (video.paused || video.ended) {
				if (video.ended) video.currentTime = 0;
				video.play().catch(function () {});
			} else {
				video.pause();
			}
		}

		video.addEventListener('click', toggle);
		video.addEventListener('keydown', function (event) {
			if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				toggle();
			}
		});

		if (!reduceMotion.matches) video.play().catch(function () {});
	})();
</script>
<div class="flex-0 pt-2 pb-6 px-4 sm:px-8 w-full md:w-3/5 lg:1/2 justify-center text-center">
	<div class="text-balance text-md md:text-lg text-gray-800 mb-4 leading-snug">ScreenHint for Mac helps you <strong>think clearly</strong> by putting the information you need right <strong>in front of you</strong>.</div>
	<a class="btn-dark bg-black inline-block px-10 py-3 rounded-sm shadow text-xl text-white font-normal hover:bg-gray-800" href="https://apps.apple.com/us/app/screenhint/id1566621533">
		Download for Mac
	</a>
</div>
